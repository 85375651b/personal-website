---
interface Props {
	label?: string;
	email?: string;
	githubUrl?: string;
	linkedInUrl?: string;
}

const {
	label = 'Contact',
	email = 'grace.guo@yale.edu',
	githubUrl = 'https://github.com/85375651b',
	linkedInUrl = 'https://www.linkedin.com/in/grace-guo-b0261a36b/',
} = Astro.props;

const mailto = email.includes('@') ? `mailto:${email}` : email;
---

<footer class="site-footer">
	<p class="contact-label">{label}</p>
	<ul class="contact-icons" aria-label="Contact links">
		<li>
			<a class="contact-icon" href={mailto} aria-label="Email">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M3 6.5A2.5 2.5 0 0 1 5.5 4h13A2.5 2.5 0 0 1 21 6.5v11A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5v-11Z"
						stroke="currentColor"
						stroke-width="1.5"></path>
					<path
						d="M4 7.5 12 13l8-5.5"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
		</li>
		<li>
			<a class="contact-icon" href={githubUrl} aria-label="GitHub" rel="noopener noreferrer" target="_blank">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M12 2C6.48 2 2 6.58 2 12.26c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.5 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.36-3.37-1.36-.45-1.17-1.12-1.48-1.12-1.48-.92-.64.07-.63.07-.63 1.02.07 1.55 1.06 1.55 1.06.9 1.56 2.36 1.11 2.94.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.13-4.56-5.02 0-1.11.39-2.01 1.03-2.72-.1-.26-.45-1.3.1-2.7 0 0 .84-.27 2.75 1.04A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.51.34 1.91-1.31 2.75-1.04 2.75-1.04.55 1.4.2 2.44.1 2.7.64.71 1.03 1.61 1.03 2.72 0 3.9-2.34 4.76-4.57 5.02.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.8 0 .28.18.6.69.5A10.03 10.03 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"
					></path>
				</svg>
			</a>
		</li>
		<li>
			<a
				class="contact-icon"
				href={linkedInUrl}
				aria-label="LinkedIn"
				rel="noopener noreferrer"
				target="_blank"
			>
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<rect
						x="3"
						y="3"
						width="18"
						height="18"
						rx="2"
						stroke="currentColor"
						stroke-width="1.5"></rect>
					<path
						fill="currentColor"
						d="M7.5 10.2v6.3H5.4V10.2h2.1Zm-.15-2.7c0 .75-.6 1.35-1.35 1.35S4.65 8.25 4.65 7.5 5.25 6.15 6 6.15s1.35.6 1.35 1.35ZM18.6 16.5h-2.1v-3.05c0-.75-.15-1.65-1.2-1.65-1.05 0-1.2.8-1.2 1.65v3.05h-2.1V10.2h2.02v.83c.42-.78 1.2-1.28 2.13-1.28 2.28 0 2.7 1.5 2.7 3.45V16.5Z"
					></path>
				</svg>
			</a>
		</li>
	</ul>
</footer>

<style>
	.site-footer {
		--footer-bg: #354a5c;

		margin-top: clamp(2rem, 6vh, 3.5rem);
		padding: 1.35rem var(--page-padding-inline-end) 1.75rem var(--page-padding-inline-start);
		background-color: var(--footer-bg);
		color: rgba(255, 255, 255, 0.88);
	}

	.contact-label {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.92);
	}

	.contact-icons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin: 0.65rem 0 0;
		padding: 0;
		list-style: none;
	}

	.contact-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		color: rgba(255, 255, 255, 0.9);
		text-decoration: none;
		transition: color 0.15s ease, opacity 0.15s ease;
	}

	.contact-icon:hover {
		color: #ffffff;
		opacity: 0.95;
	}

	.contact-icon:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.65);
		outline-offset: 3px;
		border-radius: 2px;
	}
</style>
